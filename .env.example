# Copy to .env.local (gitignored) and adjust.

# Origin of the ShopAlly Go API — scheme and host only, no path.
# Endpoint paths are composed in code because the API lives under /api/v1
# while /healthz sits at the root.
#
# Whatever origin the frontend runs on must also appear in the backend's
# CORS allowlist (cors.allowed_origins / CORS_ALLOWED_ORIGINS), or the
# browser will block every request. The backend defaults to
# http://localhost:3000, which matches `next dev`.
NEXT_PUBLIC_API_URL=http://localhost:8080
