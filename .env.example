# Copy to .env.local (gitignored) and adjust.

# Origin of the ShopAlly Go API — scheme and host only, no path.
# Endpoint paths are composed in code because the API lives under /api/v1
# while /healthz sits at the root.
#
# Whatever origin the frontend runs on must also appear in the backend's
# CORS allowlist (cors.allowed_origins / CORS_ALLOWED_ORIGINS), or the
# browser will block every request. The backend defaults to
# http://localhost:3000, which matches `next dev`.
NEXT_PUBLIC_API_URL=http://localhost:8080

# NextAuth URL
NEXTAUTH_URL=http://localhost:3000

# NextAuth internal encryption secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<replace-with-openssl-rand-base64-32-output>

# Dedicated shared secret used to mint HS256 API tokens for the Go backend.
# Must match the backend's AUTH_JWT_SECRET (at least 32 characters).
# Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=<replace-with-openssl-rand-base64-32-output>

# Google OAuth Credentials (console.cloud.google.com -> Credentials -> OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
